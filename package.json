{
  "name": "skyq",
  "version": "1.0.0",
  "description": "SKYGUESSR — find the route. Daily flight-route deduction game (web + iOS).",
  "private": true,
  "scripts": {
    "build:www": "node tools/build-www.js",
    "build:standalone": "node tools/build-single.js",
    "test": "node tools/test-engine.js",
    "icons": "node tools/genicons.js assets/icons",
