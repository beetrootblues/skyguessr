    "ios": "npm run cap:sync && npx cap open ios",
    "ipa": "bash tools/build-ipa.sh"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9"
  }
}
